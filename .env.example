# Copy to .env (git-ignored) and adjust. Read by docker compose.
DB_USERNAME=bmb
DB_PASSWORD=change-me
# Bootstrap administrator, created on first start if both are set.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Admin1
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
# Optional local AI through Ollama
AI_ENABLED=false
AI_MODEL=llama3.2:3b
