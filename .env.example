# Copy to .env (git-ignored) and set real values. Read by docker compose.

# --- Required -----------------------------------------------------------------------------------
DB_PASSWORD=change-me-to-a-long-random-string
# Bootstrap administrator, created on first start (password: at least 8 characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Admin1

# --- Network ------------------------------------------------------------------------------------
HTTP_PORT=3000
# Public origin of the site (scheme://host[:port])
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set to true when the site is served over HTTPS (secure session cookie)
COOKIE_SECURE=false

# --- Optional -----------------------------------------------------------------------------------
DB_USERNAME=bmb
DB_POOL_SIZE=10
# Swagger UI on http://localhost:8080/swagger-ui.html (the API port is bound to localhost only)
SWAGGER_ENABLED=false
# classpath:db/migration only = empty store without the demo catalog
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
RATE_LIMIT_ENABLED=true
APP_VERSION=local

# Local AI through Ollama (docker compose --profile ai ...)
AI_ENABLED=false
AI_MODEL=llama3.2:3b
AI_TIMEOUT=60s
